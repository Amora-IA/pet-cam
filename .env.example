# --- Frontend (Vercel) ---

# Public URL of the signaling server for remote pairing (Fase 2).
# Leave unset for local/self-hosted use (falls back to the same LAN heuristic
# that already works with `npm run dev:all`).
# Example: VITE_SIGNAL_URL=wss://petwatch-signal.fly.dev
VITE_SIGNAL_URL=

# --- Signaling server (Fly.io / Render / your own VPS) ---
# Everything below runs server-side only. Never move a TURN API key into a
# VITE_ variable — those get baked into the public JS bundle for anyone to
# read, which would let a stranger mint credentials on your account.

# Comma-separated list of allowed origins for CORS + WebSocket upgrade.
# Set this to your Vercel URL(s) once deployed. Leave empty only for local dev.
# Example: ALLOWED_ORIGINS=https://petwatch.vercel.app
ALLOWED_ORIGINS=

# Port the signaling server listens on (most platforms set this for you).
SIGNAL_PORT=8787

# Optional TURN relay (needed for viewers on a different network than the
# camera — mobile data, corporate NAT, etc). The server fetches credentials
# from your provider on each request and hands them to the browser without
# ever exposing the API key. Works out of the box with metered.ca's TURN
# REST API — TURN_DOMAIN is the subdomain shown on your dashboard
# (e.g. petwatch.metered.live), TURN_API_KEY the key from the same page.
TURN_API_KEY=
TURN_DOMAIN=
